# ReticulumHF Service Configuration
#
# This is the *default* / template for a fresh deploy. Override
# individual values by either:
#   1. editing this file before first boot, or
#   2. setting the corresponding shell vars in /etc/default/
#   3. running the bootstrap script (bootstrap.sh in this repo)
#      with --ssid=... --ap-password=... --zt-network=...

# Radio (Xiegu G90 / QYT KT-8900D default)
RADIO_ID=xiegu_g90

# Serial port (FTDI cable) — adjust per box
SERIAL_PORT=/dev/ttyUSB0

# USB audio card number — adjust per box
AUDIO_CARD=3

# FreeDV mode — DATAC1 is the 2026 default for ARDOP compatibility
FREEDV_MODE=DATAC1

# TX audio level (dB) - reduce if radio power fluctuates (ALC kicking in)
TX_OUTPUT_VOLUME=0

# rigctld command (CAT control of the G90 via FTDI cable)
RIGCTLD_CMD="rigctld -m 3088 -r /dev/ttyUSB0 -s 19200 -t 4532 -P RTS"

# freedvtnc2 command (FreeDV TNC for HF digital modes)
FREEDVTNC2_CMD="/home/pi/.local/bin/freedvtnc2 --no-cli --input-device 1 --output-device 1 --mode DATAC1 --rigctld-port 4532 --kiss-tcp-port 8001 --kiss-tcp-address 0.0.0.0 --cmd-port 8002 --cmd-address 0.0.0.0 --ptt-on-delay-ms 300 --ptt-off-delay-ms 200 --output-volume 0"

# WiFi AP settings. CHANGE_ME before flashing.
RETICULUMHF_AP_SSID=g90digi
RETICULUMHF_AP_PASS=CHANGE_ME
RETICULUMHF_AP_CHANNEL=7
