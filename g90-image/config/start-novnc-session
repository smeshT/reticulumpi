#!/bin/bash
# start-novnc-session — start the Xvfb + openbox + x11vnc + websockify stack
# on the g90 box. websockify runs in the foreground so systemd sees it
# as the service's main process.
#
# No VNC password (per operator 2026-09-09 15:14 MDT): the random
# 8-char password the bootstrap used to generate was hostile to the
# operator's browser-stored password (every re-run broke login), and
# provides no real security — anyone with LAN access can already pwn
# the Pi. The hostapd WPA2 password on the wifi client portal is the
# only network-level auth that matters.
#
# If you want a password, add `-rfbauth /etc/x11vnc/passwd` to the
# x11vnc line and run `sudo x11vnc -storepasswd <yourpw>
# /etc/x11vnc/passwd` to create the file. Until then, noVNC is open.
#
# The XDG_RUNTIME_DIR directory is created if missing (some ReticulumHF
# base images don't pre-create /run/user/1000 for headless users).
set -e

export DISPLAY=:1
export XDG_RUNTIME_DIR=/run/user/1000

mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"

# Start Xvfb (the virtual display)
Xvfb :1 -screen 0 1280x720x24 &
XVFB_PID=$!

# Wait for Xvfb to be ready (max 5s)
for i in {1..50}; do
    if [ -e /tmp/.X11-unix/X1 ]; then
        break
    fi
    sleep 0.1
done

# Start openbox (window manager)
DISPLAY=:1 openbox &
OPENBOX_PID=$!

# Start x11vnc (VNC server) — log to stderr (which goes to journal)
# No -rfbauth flag = no VNC password. LAN-only access is the security model.
# To re-enable, add: -rfbauth /etc/x11vnc/passwd
# (and run `sudo x11vnc -storepasswd <pw> /etc/x11vnc/passwd` first).
x11vnc -display :1 -forever -shared -rfbport 5900 &
X11VNC_PID=$!

# Wait for x11vnc to bind (max 5s)
for i in {1..50}; do
    if ss -lnt | grep -q ':5900 '; then
        break
    fi
    sleep 0.1
done

# If x11vnc didn't bind, log it and bail
if ! ss -lnt | grep -q ':5900 '; then
    echo "x11vnc did not bind to :5900 within 5s; check display and journal" >&2
    kill $XVFB_PID $OPENBOX_PID $X11VNC_PID 2>/dev/null || true
    exit 1
fi

# Start websockify in the FOREGROUND
exec websockify --web=/usr/share/novnc 6080 localhost:5900
