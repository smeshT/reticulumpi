[Unit]
# /etc/systemd/system/g90-shared-launcher.service
# Parallel "shared launcher" Flask app for the g90 box. Listens on :80
# so wifi clients land on it after the captive-portal redirect. The
# ReticulumHF setup wizard is on :8080; node-portal (wifi admin) is
# on :8081. Same port as sbitx's my-launcher for cross-box consistency.
#
# This is a sibling of the sbitx box's /home/pi/my_launcher.
#
# DO NOT start the launcher manually with `sudo python3 ...` — that
# leaves an orphan root process holding :80, while systemd's
# ExecStart fails with "Address already in use" and the unit enters
# a restart loop. The launcher's Popen() children inherit root UID,
# so lxterminal + modem73 + freedvtnc2 launched from the UI run as
# root and are invisible / inaccessible to the pi user running
# noVNC. Symptom: clicking "Modem73 TUI: Start" or "freedvtnc2 Chat:
# Start" opens a window that immediately disappears from the noVNC
# tab. Fix: `pkill -f 'python3 /home/pi/shared_launcher/app.py'`
# then `sudo systemctl restart g90-shared-launcher.service`. The
# right way to test from a shell is `sudo systemctl restart ...`
# (which goes through systemd and respects User=pi).

[Unit]
Description=G90 Shared Launcher
After=network.target

[Service]
User=pi
WorkingDirectory=/home/pi/shared_launcher
# LAUNCHER_PORT=80 is the port the launcher binds. We set it
# explicitly here so the unit file is self-documenting and a
# future change to app.py's default can't silently flip the
# g90's port.
#
# Why :80 and not :8090: on a deployed g90 box, the wifi clients
# that join the g90's AP need to hit a captively-redirected
# page. The shared launcher is that page (it's the daily-driver
# UI for ham operations: flrig/js8call/wsjtx start/stop, modem73
# audio reset, meshchat, freedvtnc2, Reticulum status). Port :80
# is what clients land on after the captive-portal redirect, so
# the launcher has to be on :80.
#
# On g90digi this is the long-standing layout; the reticulumpi
# bootstrap now matches it (per operator 2026-09-09 15:26 MDT —
# the launcher should be on :80, the ReticulumHF wizard on :8080,
# node-portal wifi admin on :8081).
#
# The g90-test-launcher.service overrides this to 9090 (test sled).
Environment=LAUNCHER_PORT=80
ExecStart=/usr/bin/python3 /home/pi/shared_launcher/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
