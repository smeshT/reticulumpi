[Unit]
Description=LXMF Propagation Node Daemon (lxmd)
Documentation=https://github.com/markqvist/LXMF
After=network-online.target zerotier-one.service reticulumhf-rnsd.service
Wants=zerotier-one.service reticulumhf-rnsd.service
Requires=reticulumhf-rnsd.service

[Service]
Type=simple
User=pi
Group=pi
Environment=HOME=/home/pi

# --- ExecStart: EVERY continuation line MUST end in a backslash. ---
#
# This unit shipped as a bare `ExecStart=/home/pi/.local/bin/lxmd` with no
# arguments. Hand-edits added the flags below but dropped the backslashes,
# and systemd silently parses orphaned lines as invalid directives and
# discards them. The result on g90digi and m5boss was identical and
# invisible from `systemctl is-active`:
#
#   * no --propagation-node -> lxmd ran as a plain LXMF router, no PN
#   * no --config           -> used the default config path and treated
#                              ~/.lxmd/config (a FILE) as a directory:
#                              NotADirectoryError '.../.lxmd/config/storage'
#                              -> 615 restarts in a crash loop
#   * no --service          -> output went to the journal only, so
#                              ~/.lxmd/logfile sat frozen while
#                              `journalctl -u lxmd` showed only
#                              Started/Stopped, hiding the fault
#
# Verify after any edit:
#   systemctl show lxmd.service -p ExecStart
# argv[] must list all four flags. If only the binary appears, the
# backslashes are missing again.
ExecStart=/home/pi/.local/bin/lxmd \
--rnsconfig /home/pi/.reticulum \
--propagation-node \
--config /home/pi/.lxmd \
--service
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# lxmd writes messagestore, node_stats, peers, logfile, ratchets
ReadWritePaths=/home/pi/.lxmd /home/pi/.reticulum
PrivateTmp=true

[Install]
WantedBy=multi-user.target
