{
  "release": "v0.6.28",
  "release_date": "2026-09-09",
  "image_baseline": "g90digi-2026-08-09",
  "channel": "https://github.com/smeshT/reticulumpi.git",
  "branch": "main",
  "components": {
    "launcher": {
      "type": "github-pull",
      "auto_update": true,
      "source_path": "/"
    },
    "systemd_units": [
      {
        "name": "g90-shared-launcher.service",
        "required": true
      },
      {
        "name": "reticulumhf-rnsd.service",
        "required": true
      },
      {
        "name": "meshchatx.service",
        "required": true
      },
      {
        "name": "lxmd.service",
        "required": true
      }
    ],
    "pip_packages": [
      {
        "venv": "rns",
        "package": "rns",
        "min_version": "1.4.0"
      },
      {
        "venv": "rns",
        "package": "lxmf",
        "min_version": "1.1.0"
      },
      {
        "venv": "reticulum-meshchatx",
        "package": "reticulum-meshchatx",
        "min_version": "4.8.0"
      }
    ],
    "config_files": [
      {
        "path": "/home/pi/.reticulum/config",
        "required": true
      },
      {
        "path": "/etc/systemd/system/meshchatx.service",
        "required": true
      },
      {
        "path": "/usr/local/bin/restart-meshchatx",
        "required": true,
        "mode": "0755"
      },
      {
        "path": "/home/pi/shared_launcher/scripts/start_pavucontrol.sh",
        "required": true,
        "mode": "0755"
      },
      {
        "path": "/home/pi/shared_launcher/scripts/stop_pavucontrol.sh",
        "required": true,
        "mode": "0755"
      }
    ]
  },
  "notes": "v0.6.28: fix pipx shim binary name in bootstrap script (meshchatx).\n\nThe pipx package is 'reticulum-meshchatx' but the\nconsole_script inside the package is named 'meshchatx' (no\nprefix). The shim is created at /home/pi/.local/bin/meshchatx,\nnot /home/pi/.local/bin/reticulum-meshchatx.\n\nThe script's verify check was looking for the wrong name.\nFix: change the check from 'reticulum-meshchatx' to 'meshchatx'.\nThe pipx install command still uses the package name\n'reticulum-meshchatx' (that's how PyPI publishes it)."
}