{
  "release": "v0.6.30",
  "release_date": "2026-09-09",
  "image_baseline": "g90digi-2026-08-09",
  "channel": "https://github.com/smeshT/reticulumpi.git",
  "branch": "main",
  "components": {
    "launcher": {
      "type": "github-pull",
      "auto_update": true,
      "source_path": "/"
    },
    "systemd_units": [
      {
        "name": "g90-shared-launcher.service",
        "required": true
      },
      {
        "name": "reticulumhf-rnsd.service",
        "required": true
      },
      {
        "name": "meshchatx.service",
        "required": true
      },
      {
        "name": "lxmd.service",
        "required": true
      }
    ],
    "pip_packages": [
      {
        "venv": "rns",
        "package": "rns",
        "min_version": "1.4.0"
      },
      {
        "venv": "rns",
        "package": "lxmf",
        "min_version": "1.1.0"
      },
      {
        "venv": "reticulum-meshchatx",
        "package": "reticulum-meshchatx",
        "min_version": "4.8.0"
      }
    ],
    "config_files": [
      {
        "path": "/home/pi/.reticulum/config",
        "required": true
      },
      {
        "path": "/etc/systemd/system/meshchatx.service",
        "required": true
      },
      {
        "path": "/usr/local/bin/restart-meshchatx",
        "required": true,
        "mode": "0755"
      },
      {
        "path": "/home/pi/shared_launcher/scripts/start_pavucontrol.sh",
        "required": true,
        "mode": "0755"
      },
      {
        "path": "/home/pi/shared_launcher/scripts/stop_pavucontrol.sh",
        "required": true,
        "mode": "0755"
      }
    ]
  },
  "notes": "v0.6.30: fix x11vnc -storepasswd permission in bootstrap script.\n\nThe script ran 'sudo -u pi x11vnc -storepasswd ...' but\n/etc/x11vnc/ is owned by root with mode 755 \u2014 pi can't\nwrite to a root-owned 755 directory.\n\nFix: run x11vnc -storepasswd as root (sudo without -u pi),\nthen chmod 600 and chown pi:pi so x11vnc.service (which\nruns as pi) can read the file.\n\nSame pattern applies to other password-file-style operations\nwhere root creates the file and the service reads it."
}