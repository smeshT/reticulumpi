{
  "release": "v0.6",
  "release_date": "2026-09-08",
  "image_baseline": "g90digi-2026-08-09",
  "channel": "https://github.com/smeshT/reticulumpi.git",
  "branch": "main",
  "components": {
    "launcher": {
      "type": "github-pull",
      "auto_update": true,
      "source_path": "/"
    },
    "systemd_units": [
      {"name": "g90-shared-launcher.service", "required": true},
      {"name": "reticulumhf-rnsd.service",    "required": true},
      {"name": "meshchatx.service",           "required": true},
      {"name": "modem73.service",             "required": true},
      {"name": "lxmd.service",                "required": true}
    ],
    "pip_packages": [
      {"venv": "rns",                 "package": "rns",          "min_version": "1.4.0"},
      {"venv": "rns",                 "package": "lxmf",         "min_version": "1.1.0"},
      {"venv": "reticulum-meshchatx",  "package": "reticulum-meshchatx", "min_version": "4.8.0"}
    ],
    "config_files": [
      {"path": "/home/pi/.reticulum/config",                        "required": true},
      {"path": "/etc/systemd/system/modem73.service",               "required": true},
      {"path": "/etc/systemd/system/meshchatx.service",             "required": true},
      {"path": "/usr/local/bin/restart-meshchatx",                  "required": true, "mode": "0755"}
    ]
  },
  "notes": "v0.6 adds the self-bootstrapping launcher: github is the source of truth, g90digi pulls from there on operator click. Image-baked units and pip packages are not auto-installed — reflash to bring them in line. The component check on the version page reports drift so the operator knows what to fix."
}
