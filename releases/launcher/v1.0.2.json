{
  "release": "v1.0.2",
  "release_date": "2026-09-17",
  "image_baseline": "pi-os-lite-2026-09-10",
  "channel": "https://github.com/smeshT/reticulumpi.git",
  "branch": "main",
  "components": {
    "launcher": {
      "type": "github-pull",
      "auto_update": true,
      "source_path": "/"
    },
    "systemd_units": [
      {
        "name": "g90-shared-launcher.service",
        "required": true
      },
      {
        "name": "reticulumhf-rnsd.service",
        "required": true
      },
      {
        "name": "meshchatx.service",
        "required": true
      },
      {
        "name": "lxmd.service",
        "required": true
      }
    ],
    "pip_packages": [
      {
        "venv": "rns",
        "package": "rns",
        "min_version": "1.4.0"
      },
      {
        "venv": "rns",
        "package": "lxmf",
        "min_version": "1.1.0"
      },
      {
        "venv": "reticulum-meshchatx",
        "package": "reticulum-meshchatx",
        "min_version": "4.8.0"
      }
    ],
    "config_files": [
      {
        "path": "/home/pi/.reticulum/config",
        "required": true
      },
      {
        "path": "/etc/systemd/system/meshchatx.service",
        "required": true
      },
      {
        "path": "/usr/local/bin/restart-meshchatx",
        "required": true,
        "mode": "0755"
      },
      {
        "path": "/home/pi/shared_launcher/scripts/start_pavucontrol.sh",
        "required": true,
        "mode": "0755"
      },
      {
        "path": "/home/pi/shared_launcher/scripts/stop_pavucontrol.sh",
        "required": true,
        "mode": "0755"
      }
    ]
  },
  "notes": "v1.0.2: fix stop_js8call pattern so nohup-wrapped instances are killed; revert latest.json from broken v1.0.1 to v1.0.0; re-released as v1.0.2",
  "milestone": true,
  "milestone_summary": "fix stop_js8call.sh: nohup wraps argv so pgrep pattern needs to match binary path. stop_proc_tree silently did nothing, leaving zombie js8call instances that held PulseAudio sockets."
}
