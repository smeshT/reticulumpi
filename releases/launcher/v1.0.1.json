{
  "release": "v1.0.1",
  "release_date": "2026-09-11",
  "image_baseline": "pi-os-lite-2026-09-10",
  "channel": "https://github.com/smeshT/reticulumpi.git",
  "branch": "main",
  "components": {
    "launcher": {
      "type": "github-pull",
      "auto_update": true,
      "source_path": "/"
    },
    "systemd_units": [
      {
        "name": "g90-shared-launcher.service",
        "required": true
      },
      {
        "name": "reticulumhf-rnsd.service",
        "required": true
      },
      {
        "name": "meshchatx.service",
        "required": true
      },
      {
        "name": "lxmd.service",
        "required": true
      }
    ],
    "pip_packages": [
      {
        "venv": "rns",
        "package": "rns",
        "min_version": "1.4.0"
      },
      {
        "venv": "rns",
        "package": "lxmf",
        "min_version": "1.1.0"
      },
      {
        "venv": "reticulum-meshchatx",
        "package": "reticulum-meshchatx",
        "min_version": "4.8.0"
      }
    ],
    "config_files": [
      {
        "path": "/home/pi/.reticulum/config",
        "required": true
      },
      {
        "path": "/etc/systemd/system/meshchatx.service",
        "required": true
      },
      {
        "path": "/usr/local/bin/restart-meshchatx",
        "required": true,
        "mode": "0755"
      },
      {
        "path": "/home/pi/shared_launcher/scripts/start_pavucontrol.sh",
        "required": true,
        "mode": "0755"
      },
      {
        "path": "/home/pi/shared_launcher/scripts/stop_pavucontrol.sh",
        "required": true,
        "mode": "0755"
      }
    ]
  },
  "notes": "v1.0.1 added ReticulumPi as title"
  "milestone": true,
  "milestone_summary": "Config backup / restore is a first-class feature of the launcher. Standalone shell scripts cover boxes that can't run the launcher (g90f1r2 on ECG_Guest wifi). Bootstrap hardened to recover from partial runs. 11 incremental releases in the v0.6.4x series tested and shipped since v0.6.43."
}
