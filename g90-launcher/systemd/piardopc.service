[Unit]
Description=piardopc ARDOP modem (g90)
Documentation=https://github.com/openclaw/openclaw
# Piardopc must start AFTER the bridge owns the FTDI cable and :8515 listener.
# Runs WITHOUT the -p flag — bridge handles hardware PTT via FTDI.
# Bridge on :8517 -> piardopc on :8515 (ARDOP TNC).
# Bridge on :8518 -> piardopc on :8516 (companion probe).
After=ardop-ptt-bridge.service
After=sound.target
Requires=ardop-ptt-bridge.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/ardop
# ARDOP TNC :8515, companion :8516, audio in/out plughw:1,0 (USB CODEC).
# NO -p flag — bridge owns the FTDI cable.
ExecStart=/home/pi/ardop/./piardopc 8515 plughw:1,0 plughw:1,0
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=false

# NOTE: no [Install] section on purpose. piardopc must NEVER auto-start.
# Auto-start means a flashed SD card boots into the ARDOP modem grabbing
# the USB CODEC audio device with no operator present. piardopc is enabled
# only by an explicit click on the launcher's Start button, which runs
# `sudo -n systemctl enable --now piardopc.service` after confirming the
# bridge owns the FTDI cable. The install.sh script that drops this unit
# on a fresh box does `disable` after copy, not `enable`, so the unit is
# installed but inert.