[Unit]
Description=ARDOP PTT bridge + hamlib CAT relay (g90)
Documentation=https://github.com/openclaw/openclaw
# Bridge must own the FTDI cable before piardopc/pat start.
# Replaces obsolete rigctld.service — bridge handles PTT and CAT via :8517/:8518/:4532.
# Conflicts with flrig.service so only one owns the FTDI cable at a time.
# To use flrig directly, run g90-flrig which does the handoff cleanly.
After=local-fs.target
Before=piardopc.service pat-http.service
Conflicts=flrig.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/ardop
ExecStart=/usr/bin/python3 /home/pi/ardop/ardop_ptt_bridge.py
Restart=on-failure
RestartSec=3
# Stdout/stderr go to journal by default; view with
# `journalctl -u ardop-ptt-bridge.service -f`.
# (StandardOutput=append:/tmp/... failed under ProtectHome — Permission denied.)

# Hardening
NoNewPrivileges=true
ProtectSystem=full
# ProtectHome=read-only disabled: bridge log lives in /tmp; ProtectHome
# makes /tmp read-only for the service, which breaks StandardOutput=append.
PrivateTmp=false

# NOTE: no [Install] section on purpose. The bridge must NEVER auto-start.
# Auto-start means a flashed SD card boots into a stack that grabs the
# FTDI cable and the audio device with no operator present — exactly the
# thing that burned up g90digi's USB-C cable in 2026-08. The bridge is
# enabled only by an explicit click on the launcher's Start button, which
# runs `sudo -n systemctl enable --now ardop-ptt-bridge.service`. The
# install.sh script that drops this unit on a fresh box does `disable`
# after copy, not `enable`, so the unit is installed but inert.