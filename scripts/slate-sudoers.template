# /etc/sudoers.d/020_slate
# Scoped NOPASSWD for Slate (the AI assistant running as user `pi`).
# Installed by Jack 2026-06-03. Reviewed scope: package install + samba
# service management + reading/writing the samba config + managing one
# samba user. Nothing else.
#
# Honest note on scope: sudo evaluates rules left-to-right and the LAST
# matching rule wins. Cmnd_Alias whitelists DO work as a hard boundary —
# if you grep this file, you can see the exact list of commands I'm
# allowed to run. They don't expand at runtime.
#
# KILL SWITCH:  sudo rm -f /etc/sudoers.d/020_slate
# Or run:       /home/pi/.openclaw/workspace/scripts/slate-revoke.sh
# Or the auto-revoke cron in 24h if I set it (see slate-rotate.sh).
#
# To extend scope: edit this file via `visudo -f /etc/sudoers.d/020_slate`.

# --- Packages: only install samba (and a couple of samba-adjacent utils) ---
Cmnd_Alias SLATE_PKG = /usr/bin/apt-get install -y samba, \
                       /usr/bin/apt-get install -y samba-common-bin, \
                       /usr/bin/apt-get install -y smbclient

# --- Service management: only smbd/nmbd, only the verbs we actually need ---
Cmnd_Alias SLATE_SVC = /usr/bin/systemctl enable smbd, \
                       /usr/bin/systemctl enable nmbd, \
                       /usr/bin/systemctl disable smbd, \
                       /usr/bin/systemctl disable nmbd, \
                       /usr/bin/systemctl restart smbd, \
                       /usr/bin/systemctl restart nmbd, \
                       /usr/bin/systemctl start smbd, \
                       /usr/bin/systemctl start nmbd, \
                       /usr/bin/systemctl stop smbd, \
                       /usr/bin/systemctl stop nmbd, \
                       /usr/bin/systemctl status smbd, \
                       /usr/bin/systemctl status nmbd, \
                       /usr/bin/systemctl is-active smbd, \
                       /usr/bin/systemctl is-active nmbd, \
                       /usr/bin/journalctl -u smbd *, \
                       /usr/bin/journalctl -u nmbd *

# --- Config: read/validate the samba config. We use `tee` to write it
#     (we can't write directly to /etc/samba/smb.conf as pi, but tee
#     with sudo can). visudo -c validates our own file edits. ---
Cmnd_Alias SLATE_CONF = /usr/bin/tee /etc/samba/smb.conf, \
                        /usr/bin/testparm -s

# --- Users: only add/remove the `slate` samba user ---
Cmnd_Alias SLATE_USR = /usr/bin/smbpasswd -a slate, \
                       /usr/bin/smbpasswd -n slate, \
                       /usr/bin/smbpasswd -x slate

# --- Firewall: only open the samba ports (137/138/139/445) ---
Cmnd_Alias SLATE_FW = /usr/sbin/ufw allow samba, \
                      /usr/sbin/ufw status, \
                      /usr/sbin/ufw reload

pi ALL=(root) NOPASSWD: SLATE_PKG, SLATE_SVC, SLATE_CONF, SLATE_USR, SLATE_FW
